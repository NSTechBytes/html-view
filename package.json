{
  "name": "html-view",
  "displayName": "HTML View",
  "description": "View and preview HTML files inside VS Code",
  "version": "0.0.1",
  "publisher": "NSTechBytes",
  "icon": "images/html-view.png",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:htmlView.preview"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "htmlView.preview",
        "title": "Preview HTML",
        "category": "HTML View"
      }
    ],
    "keybindings": [
      {
        "command": "htmlView.preview",
        "key": "ctrl+alt+v",
        "when": "editorLangId == html"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NSTechBytes/html-view"
  },
  "homepage": "https://github.com/NSTechBytes/html-view",
  "bugs": {
    "url": "https://github.com/NSTechBytes/html-view/issues"
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.97.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.19.0"
  },
  "dependencies": {}
}